# 目标网站地址（默认 sehuatang.org，也可改为 .net）
BASE_URL=https://sehuatang.org

# 本服务对外公开的根地址，只用于首页 canonical。
# 仅支持 http/https。不要写入账号、cookie 或密钥。
# 本地预览可改为 http://127.0.0.1:8000
PUBLIC_BASE_URL=https://98trss.chainseek.top

# 缓存过期时间（秒），默认 15 分钟
CACHE_TTL=900

# HTTP 请求超时时间（秒）
REQUEST_TIMEOUT=30

# 可选：手动注入浏览器 cookie（用于绕过 Cloudflare）
# 从浏览器开发者工具中复制完整 cookie 字符串
SESSION_COOKIE=
